void vsop87_saturn(float t, out vec3 spherical) {
    float power[6] = float[](
        1.0, t, t * t, t * t * t, t * t * t * t, t * t * t * t * t
    );
    float longitude = 0.0;
    for (int i = 0; i < VSOP_SATURN_L_N; ++i) {
        vec4 term = VSOP_SATURN_L[i];
        longitude += term.x * cos(term.y + term.z * t) * power[int(term.w)];
    }
    float latitude = 0.0;
    for (int i = 0; i < VSOP_SATURN_B_N; ++i) {
        vec4 term = VSOP_SATURN_B[i];
        latitude += term.x * cos(term.y + term.z * t) * power[int(term.w)];
    }
    float distance = 0.0;
    for (int i = 0; i < VSOP_SATURN_R_N; ++i) {
        vec4 term = VSOP_SATURN_R[i];
        distance += term.x * cos(term.y + term.z * t) * power[int(term.w)];
    }
    spherical = vec3(longitude, latitude, distance);
}

