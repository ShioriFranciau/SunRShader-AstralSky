void vsop87_earth(float t, out vec3 spherical) {
    float power[6] = float[](
        1.0, t, t * t, t * t * t, t * t * t * t, t * t * t * t * t
    );
    float longitude = 0.0;
    for (int i = 0; i < VSOP_EARTH_L_N; ++i) {
        vec4 term = VSOP_EARTH_L[i];
        longitude += term.x * cos(term.y + term.z * t) * power[int(term.w)];
    }
    float latitude = 0.0;
    for (int i = 0; i < VSOP_EARTH_B_N; ++i) {
        vec4 term = VSOP_EARTH_B[i];
        latitude += term.x * cos(term.y + term.z * t) * power[int(term.w)];
    }
    float distance = 0.0;
    for (int i = 0; i < VSOP_EARTH_R_N; ++i) {
        vec4 term = VSOP_EARTH_R[i];
        distance += term.x * cos(term.y + term.z * t) * power[int(term.w)];
    }
    spherical = vec3(longitude, latitude, distance);
}

// Bodies follow the order of Vsop87.Body: Mercury, Venus, Mars,
// Jupiter, Saturn, Uranus, Neptune, Earth.
vec3 vsop87_heliocentric(int body, float t) {
    vec3 spherical = vec3(0.0, 0.0, 1.0);
    if (body == 0) {
        vsop87_mercury(t, spherical);
    }
    else if (body == 1) {
        vsop87_venus(t, spherical);
    }
    else if (body == 2) {
        vsop87_mars(t, spherical);
    }
    else if (body == 3) {
        vsop87_jupiter(t, spherical);
    }
    else if (body == 4) {
        vsop87_saturn(t, spherical);
    }
    else if (body == 5) {
        vsop87_uranus(t, spherical);
    }
    else if (body == 6) {
        vsop87_neptune(t, spherical);
    }
    else if (body == 7) {
        vsop87_earth(t, spherical);
    }
    return spherical;
}

